FROM python:3.13.15-slim-trixie

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN useradd --create-home --uid 10001 praxis

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY backend/src ./backend/src

# Package installation is build-only; do not ship installers or bootstrap wheels.
RUN uv sync --frozen --no-cache --no-dev \
    && /usr/local/bin/python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.13/ensurepip \
    && rm /bin/uv /bin/uvx

# The service never needs a utility to elevate its non-root execution identity.
RUN find /usr -xdev -type f -perm /6000 -exec chmod a-s {} +

USER praxis

EXPOSE 8080

CMD ["opentelemetry-instrument", "python", "-m", "praxis.agent.runtime"]
