# Build locked dependencies separately from the shell-free serving image.
FROM python:3.13.15-slim-trixie AS build

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY backend/src ./backend/src

# Match distroless's interpreter location so the copied virtualenv stays usable.
RUN uv sync --frozen --no-cache --no-dev --no-editable \
    && ln -sf /usr/bin/python3 /app/.venv/bin/python

FROM gcr.io/distroless/python3-debian13:nonroot@sha256:f3d5ddc6c64a019fe520e7f005f2880be21e6afc461b10a3c15ef2e4edc71e33

ENV PATH="/app/.venv/bin:/usr/bin" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=build /app/.venv /app/.venv
USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/app/.venv/bin/opentelemetry-instrument", "/app/.venv/bin/python", "-m", "praxis.agent.runtime"]
