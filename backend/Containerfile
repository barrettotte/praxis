# Assemble a patched upstream interpreter and locked dependencies for a shell-free runtime.
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS build

# Build Python against the same distribution as every serving library.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl xz-utils libssl-dev zlib1g-dev \
    libbz2-dev libffi-dev liblzma-dev tzdata \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libc6)" ge 2.39-0ubuntu8.8
WORKDIR /tmp/python-build
RUN curl -fsSLo python.tar.xz https://www.python.org/ftp/python/3.13.15/Python-3.13.15.tar.xz \
    && echo '1e66a7945a48390ee4c2a4268a0e4185884059a13c4aab6d148aa208deea4a76  python.tar.xz' | sha256sum -c - \
    && tar -xf python.tar.xz --strip-components=1 \
    && ./configure --enable-shared --without-ensurepip --disable-test-modules \
    && make -j4 && make install \
    && ldconfig && ln -s python3 /usr/local/bin/python

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY scripts/package-python-runtime.sh /tmp/package-python-runtime.sh
RUN PRAXIS_CONTAINER_BUILD=1 bash /tmp/package-python-runtime.sh

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY backend/src ./backend/src

RUN uv sync --frozen --no-cache --no-dev --no-editable

FROM scratch

ENV PATH="/app/.venv/bin:/usr/local/bin:/usr/bin" \
    LD_LIBRARY_PATH="/usr/local/lib" \
    LANG="C.UTF-8" \
    SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=build /runtime/ /
COPY --from=build /app/.venv /app/.venv
USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/app/.venv/bin/opentelemetry-instrument", "/app/.venv/bin/python", "-m", "praxis.agent.runtime"]
