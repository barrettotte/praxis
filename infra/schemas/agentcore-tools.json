[
  {
    "name": "search_catalog",
    "description": "Find relevant books, projects, technical artifacts, and museum objects using text and exact filters.",
    "inputSchema": {
      "type": "object",
      "description": "Validated inputs for a bounded local catalog search.",
      "properties": {
        "query": {
          "type": "string"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "The supported catalog record kinds."
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date_from": {
          "type": "string"
        },
        "date_to": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "Bounded catalog search response.",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "year": {
                "type": "integer"
              },
              "category": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "manufacturer": {
                "type": "string"
              }
            },
            "required": [
              "evidence_id",
              "kind",
              "score"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    }
  },
  {
    "name": "get_catalog_item",
